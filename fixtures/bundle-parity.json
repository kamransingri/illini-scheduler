{
  "_about": "Shared cases for the two copies of the section-bundle rule (pipeline/export.py bundles() and web/lib/schedule.ts buildBundles()). Both test suites check these, so the copies can't drift apart unnoticed. Optional fields: a section's \"part\" of term (default \"1\") and \"special\" flag, and a case's \"include_special\" (default true).",
  "cases": [
    {
      "name": "letter groups: lecture + discussion within a group only",
      "sections": [
        {"crn": "1", "code": "AL1", "component": "primary", "group": "A", "meetings": [{"d": 10, "s": 600, "e": 650}]},
        {"crn": "2", "code": "AD1", "component": "DIS", "group": "A", "meetings": [{"d": 4, "s": 540, "e": 590}]},
        {"crn": "3", "code": "AD2", "component": "DIS", "group": "A", "meetings": [{"d": 16, "s": 540, "e": 590}]},
        {"crn": "4", "code": "BL1", "component": "primary", "group": "B", "meetings": [{"d": 10, "s": 700, "e": 750}]},
        {"crn": "5", "code": "BD1", "component": "DIS", "group": "B", "meetings": [{"d": 16, "s": 480, "e": 530}]}
      ],
      "bundles": [["1", "2"], ["1", "3"], ["4", "5"]]
    },
    {
      "name": "any lecture with any lab-discussion",
      "sections": [
        {"crn": "10", "code": "L1", "component": "primary", "group": "*", "meetings": [{"d": 21, "s": 600, "e": 650}]},
        {"crn": "11", "code": "L2", "component": "primary", "group": "*", "meetings": [{"d": 21, "s": 660, "e": 710}]},
        {"crn": "12", "code": "Y01", "component": "LBD", "group": "*", "meetings": [{"d": 8, "s": 660, "e": 740}]}
      ],
      "bundles": [["10", "12"], ["11", "12"]]
    },
    {
      "name": "standalone sections",
      "sections": [
        {"crn": "20", "code": "C1", "component": "primary", "group": "C1", "meetings": [{"d": 10, "s": 600, "e": 650}]},
        {"crn": "21", "code": "C2", "component": "primary", "group": "C2", "meetings": [{"d": 0, "s": null, "e": null}]}
      ],
      "bundles": [["20"], ["21"]]
    },
    {
      "name": "a discussion that overlaps its lecture can't go with it",
      "sections": [
        {"crn": "30", "code": "L1", "component": "primary", "group": "*", "meetings": [{"d": 10, "s": 600, "e": 650}]},
        {"crn": "31", "code": "D1", "component": "DIS", "group": "*", "meetings": [{"d": 2, "s": 630, "e": 680}]},
        {"crn": "32", "code": "D2", "component": "DIS", "group": "*", "meetings": [{"d": 2, "s": 660, "e": 710}]}
      ],
      "bundles": [["30", "32"]]
    },
    {
      "name": "first- and second-half sections at the same time don't clash",
      "sections": [
        {"crn": "40", "code": "L1", "component": "primary", "group": "*", "part": "A", "meetings": [{"d": 10, "s": 600, "e": 650}]},
        {"crn": "41", "code": "D1", "component": "DIS", "group": "*", "part": "B", "meetings": [{"d": 2, "s": 600, "e": 650}]},
        {"crn": "42", "code": "D2", "component": "DIS", "group": "*", "part": "1", "meetings": [{"d": 2, "s": 600, "e": 650}]}
